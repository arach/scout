#!/usr/bin/env python3
"""Read-only Scout menu snapshot, via supported CLI commands."""
import concurrent.futures
import datetime
import json
import math
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import time


import importlib.util
_common_spec = importlib.util.spec_from_file_location('scout_menu_common', Path(__file__).with_name('scout-menu-common.py'))
common = importlib.util.module_from_spec(_common_spec)
_common_spec.loader.exec_module(common)


def read_command(argv, json_output=True):
    env = dict(os.environ)
    try:
        if argv[0] == 'scout':
            if argv[1:3] == ['providers', 'usage']:
                common.ensure_web()
            argv = [common.scout_binary(), *argv[1:]]
        result = subprocess.run(argv, capture_output=True, text=True, timeout=8, env=env)
        if result.returncode:
            raise ValueError((result.stderr.strip() or result.stdout.strip() or 'Command failed')[:240])
        return {'data': json.loads(result.stdout) if json_output else result.stdout, 'error': None}
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        return {'data': None, 'error': str(error)[:240]}


def quota_rows(data):
    rows = []
    for provider in (data or {}).get('providers', []):
        for window in provider.get('windows', []):
            used = window.get('usedPercent')
            known = isinstance(used, (int, float)) and not isinstance(used, bool) and math.isfinite(used)
            rows.append({'provider': provider.get('label', provider.get('id', 'Provider')),
                         'window': window.get('label', ''),
                         'used': max(0, min(100, used)) if known else None,
                         'reset': window.get('resetAtLocal') or 'Reset unavailable',
                         'capturedAt': (window.get('freshness') or {}).get('capturedAt'),
                         'source': window.get('source') or 'Source unavailable',
                         'resetAt': window.get('resetAt')})
    return rows


TERMINAL_STATES = {'completed', 'done', 'answered', 'cancelled', 'failed'}

def concise(value, limit=320):
    value = re.sub(r'\[ask:[^\]]+\]\s*', '', str(value or ''))
    return re.sub(r'\s+', ' ', value).strip()[:limit]

def work_rows(rows):
    return [{'id': r.get('id', ''), 'kind': r.get('kind', ''),
             'state': r.get('state') or 'unknown', 'title': concise(r.get('summary') or r.get('id')),
             'actor': r.get('agentId') or '', 'nextActor': r.get('nextActor') or '',
             'blocked': bool(r.get('blocked')), 'ts': r.get('updatedAt'),
             'conversation': r.get('conversationId') or '', 'reason': concise(r.get('reason'))}
            for r in rows]

def machine_rows(data, peers):
    trusted = {p.get('nodeId'): p for p in peers}
    result = []
    for m in (data or {}).get('machines', []):
        if not m.get('scoutNodeId') and not m.get('isSelf'):
            continue
        peer = trusted.get(m.get('scoutNodeId'), {})
        evidence = sorted(m.get('evidence') or [], key=lambda e: e.get('observedAt') or 0, reverse=True)
        tailnet = next((e for e in evidence if e.get('kind') == 'tailnet'), {})
        result.append({'id': m.get('id'), 'name': m.get('displayName') or m.get('name') or 'Machine',
                       'hostname': m.get('name') or '', 'platform': m.get('platform') or '', 'self': bool(m.get('isSelf')),
                       'node': m.get('scoutNodeId') or '', 'trusted': bool(peer),
                       'tier': peer.get('tier') or '', 'seenAt': m.get('lastSeenAt'),
                       'online': tailnet.get('online') if isinstance(tailnet.get('online'), bool) else None,
                       'onlineAt': tailnet.get('observedAt'), 'pinned': bool(m.get('pinned'))})
    return sorted(result, key=lambda m: (not m['self'], not m['trusted'], m['name'].lower()))


def snapshot(full=False):
    started = time.monotonic()
    commands = {'service': (['systemctl', '--user', 'show', 'scout.service', '--property=ActiveState,MainPID,MemoryCurrent,ActiveEnterTimestampMonotonic,NRestarts'], False),
                'blocked': (['scout', 'status', '--all', '--blocked', '--json'], True)}
    if full:
        commands.update({'version': (['scout', 'version'], False), 'peers': (['scout', 'mesh', 'peers', '--json'], True),
                         'activity': (['scout', 'latest', '--json', '--limit', '12'], True),
                         'budgets': (['scout', 'providers', 'usage', '--cached', '--json'], True),
                         'work': (['scout', 'status', '--all', '--json'], True),
                         'machines': (['scout', 'machines', '--json'], True)})
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        futures = {key: pool.submit(read_command, *args) for key, args in commands.items()}
        results = {key: future.result() for key, future in futures.items()}
    service = dict(line.split('=', 1) for line in (results['service']['data'] or '').splitlines() if '=' in line)
    errors = {key: value['error'] for key, value in results.items() if value['error']}
    blocked = (results['blocked']['data'] or {}).get('work', [])
    config = common.config_home() / 'hypr/scout.lua'
    match = re.search(r'Scout appearance: (\w+)', config.read_text()) if config.exists() else None
    uptime = float(Path('/proc/uptime').read_text().split()[0])
    entered = int(service.get('ActiveEnterTimestampMonotonic', '0') or '0') / 1_000_000
    out = {'uptimeSeconds': max(0, round(uptime - entered)) if entered and service.get('ActiveState') == 'active' else None,
           'restarts': int(service.get('NRestarts', '0') or '0'), 'full': full, 'host': socket.gethostname(), 'updatedAt': int(time.time()*1000), 'errors': errors,
           'brokerUp': service.get('ActiveState') == 'active', 'pid': service.get('MainPID', ''),
           'memoryMB': round(int(service['MemoryCurrent'])/1024/1024) if service.get('MemoryCurrent', '').isdigit() else None,
           'blockedCount': len(blocked) if not results['blocked']['error'] else None,
           'blocked': work_rows(blocked[:8]),
           'needsYouCount': sum(r.get('nextActor') == 'operator' for r in blocked) if not results['blocked']['error'] else None,
           'appearance': match.group(1) if match else 'custom'}
    if full:
        out.update({'peerCount': len(results['peers']['data'] or []) if not results['peers']['error'] else None,
                    'version': (results['version']['data'] or '').strip().replace('scout ', ''),
                    'peers': [{'name': p.get('label') or p.get('nodeId') or 'Trusted peer', 'node': p.get('nodeId') or '', 'tier': p.get('tier') or 'unknown', 'fingerprint': p.get('fingerprint') or ''} for p in (results['peers']['data'] or [])],
                    'activity': [{'title': concise(a.get('title', '')), 'actor': a.get('actorId', ''), 'ts': a.get('ts'), 'conversation': a.get('conversationId') or ''} for a in (results['activity']['data'] or [])],
                    'budgets': quota_rows(results['budgets']['data'])})
    if full:
        work = work_rows((results['work']['data'] or {}).get('work', []))
        work.sort(key=lambda r: r.get('ts') or 0, reverse=True)
        active = [r for r in work if r['state'] not in TERMINAL_STATES and not r['blocked']]
        start_of_day = datetime.datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0).timestamp() * 1000
        today = [r for r in work if (r.get('ts') or 0) >= start_of_day]
        peers = results['peers']['data'] or []
        machines = machine_rows(results['machines']['data'], peers)
        out.update({'work': work[:24], 'activeWork': active[:8],
                    'activeCount': len(active) if not results['work']['error'] else None,
                    'completedToday': sum(r['state'] in {'completed', 'done', 'answered'} for r in today) if not results['work']['error'] else None,
                    'failedToday': sum(r['state'] == 'failed' for r in today) if not results['work']['error'] else None,
                    'machines': machines, 'machineCount': len(machines) if not results['machines']['error'] else None,
                    'todayStart': int(start_of_day), 'workCoverage': (results['work']['data'] or {}).get('coverage', {})})
    out['syncMs'] = round((time.monotonic() - started) * 1000)
    return out


if __name__ == '__main__':
    print(json.dumps(snapshot('--full' in sys.argv)))
