#!/usr/bin/env python3
"""Bounded menu actions. All routes go through the installed Scout CLI."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import quote

VIEWS = {'inbox': '/messages', 'tail': '/ops/tail', 'settings': '/settings', 'pairing': '/settings/pairing', 'home': '/', 'dispatch': '/dispatch', 'requests': '/requests', 'sessions': '/sessions', 'providers': '/providers', 'network': '/network', 'search': '/search', 'projects': '/projects'}

import importlib.util
_common_spec = importlib.util.spec_from_file_location('scout_menu_common', Path(__file__).with_name('scout-menu-common.py'))
common = importlib.util.module_from_spec(_common_spec)
_common_spec.loader.exec_module(common)


def route_for(view, identifier=''):
    if view in {'conversation', 'work', 'flight', 'agent'}:
        if not identifier or len(identifier) > 512:
            raise ValueError('Missing item ID')
        return {'conversation': '/messages/', 'work': '/work/', 'flight': '/flights/', 'agent': '/agents/'}[view] + quote(identifier, safe='') + ('/observe' if view == 'flight' else '')
    if view not in VIEWS:
        raise ValueError('Unknown Scout view')
    return VIEWS[view]

def main(args):
    env = dict(os.environ)
    if not args:
        raise ValueError('Choose open or copy-url')
    if args[0] == 'open' and 2 <= len(args) <= 3:
        route = route_for(args[1], args[2] if len(args) == 3 else '')
        result = subprocess.run([common.scout_binary(),'server','open','--path',route],capture_output=True,text=True,timeout=25,env=env)
        if result.returncode:
            raise ValueError(result.stderr.strip() or result.stdout.strip() or 'Scout could not open')
        return 'Opened in browser'
    if args == ['refresh-usage']:
        common.ensure_web()
        result = subprocess.run([common.scout_binary(), 'providers', 'usage'], capture_output=True, text=True, timeout=25, env=env)
        if result.returncode:
            raise ValueError(result.stderr.strip() or 'Could not refresh provider limits')
        return 'Provider limits refreshed'
    if len(args) == 2 and args[0] == 'copy-host':
        hostname = args[1]
        if not hostname or len(hostname) > 253 or re.search(r'[\x00-\x20\x7f]', hostname):
            raise ValueError('Invalid hostname')
        subprocess.run(['wl-copy'], input=hostname, text=True, check=True, timeout=5)
        return 'Hostname copied'
    if args == ['copy-url']:
        result = subprocess.run([common.scout_binary(),'server','start'],capture_output=True,text=True,timeout=25,env=env)
        if result.returncode:
            raise ValueError(result.stderr.strip() or 'Scout could not start')
        match = re.search(r'Scout web at (https?://\S+)', result.stdout)
        if not match:
            raise ValueError('Scout did not report its web address')
        subprocess.run(['wl-copy'],input=match.group(1),text=True,check=True,timeout=5)
        return 'Local URL copied'
    raise ValueError('Unknown action')

if __name__ == '__main__':
    try:
        print(json.dumps({'ok':True,'message':main(sys.argv[1:])}))
    except Exception as error:
        print(json.dumps({'ok':False,'message':str(error)[:240]}))
        sys.exit(1)
