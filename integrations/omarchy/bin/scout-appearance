#!/usr/bin/env python3
"""Set Scout's persistent Hyprland window treatment."""
import os
import pathlib
import subprocess
import sys

styles = {'solid': '1 override 1 override', 'subtle': '0.96 override 0.92 override', 'glass': '0.90 override 0.84 override'}
style = sys.argv[1] if len(sys.argv) == 2 else ''
if style not in styles:
    sys.exit('Usage: scout-appearance solid|subtle|glass')
path = pathlib.Path(os.environ.get('XDG_CONFIG_HOME') or pathlib.Path.home() / '.config') / 'hypr/scout.lua'
path.parent.mkdir(parents=True, exist_ok=True)
text = f'''-- Scout appearance: {style}. Managed by scout-appearance.
local scout = {{ class = "^chrome-.*-Default$", title = "^Scout$" }}
o.window(scout, {{ tag = "-default-opacity", opacity = "{styles[style]}" }})
'''
previous = path.read_text() if path.exists() else None
path.write_text(text)
try:
    subprocess.run(['hyprctl', 'reload'], check=True, stdout=subprocess.DEVNULL)
    errors = subprocess.check_output(['hyprctl', 'configerrors'], text=True).strip()
    if errors:
        raise RuntimeError(errors)
except Exception as error:
    if previous is not None:
        path.write_text(previous)
    else:
        path.unlink(missing_ok=True)
    subprocess.run(['hyprctl', 'reload'], stdout=subprocess.DEVNULL, check=False)
    subprocess.run(['notify-send', 'Scout appearance could not apply', str(error)], check=False)
    sys.exit(str(error))
print(style)
